# Supabase project (Project Settings → API). Only the anon/publishable key is ever
# used — never a service-role key. Both values are public by design (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# If your host refuses NEXT_PUBLIC_* values (e.g. Vercel's "public prefix" guard),
# use these names instead — the app reads either and passes them to the browser itself.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key

# Optional: canonical site URL used for Open Graph metadata
NEXT_PUBLIC_SITE_URL=https://wmc.app
