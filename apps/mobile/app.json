{
  "expo": {
    "name": "WMC",
    "slug": "wmc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wmc",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "app.wmc.mobile",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.wmc.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0B4A3F",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B4A3F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "WMC uses your location to show people and communities near you. Your exact location is never shared."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "WMC needs access to your photos so you can choose a profile picture."
        }
      ],
      "expo-apple-authentication",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
